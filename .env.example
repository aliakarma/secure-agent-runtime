# ── Secure Agent Runtime — Environment Variables ─────────────────────
# Copy this file to `.env` and fill in your values.

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Logging
LOG_LEVEL=INFO
LOG_JSON=0

# ChromaDB (used by docker-compose)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8080
