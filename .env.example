# ── Secure Agent Runtime — Environment Variables ─────────────────────
# Copy this file to `.env` and fill in your values.

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Logging
LOG_LEVEL=INFO
LOG_JSON=0

# ChromaDB (used by docker-compose)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8080

# ── Deployment posture ───────────────────────────────────────────────
# development (default) keeps the offline test-suite + local dashboard
# frictionless. production makes the API token mandatory and disables the
# permissive sidecar / arbitrary-file-path conveniences.
APP_ENV=development

# ── API authentication ───────────────────────────────────────────────
# When set, all mutating/data endpoints require:  Authorization: Bearer <token>
# (or  X-API-Token: <token> ). Mandatory when APP_ENV=production.
API_TOKEN=

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allow-list of browser origins. Empty = same-origin only.
ALLOWED_ORIGINS=

# ── File handling ────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=26214400          # 25 MiB
# Dev conveniences (auto-disabled in production):
ALLOW_SIDECAR=1                    # honour caller-supplied "extracted" text
ALLOW_FILE_PATH=1                  # accept a server-side path instead of upload

# ── Security strictness ──────────────────────────────────────────────
# 1 = fail closed: classifier/extractor failures block instead of degrading.
STRICT_SECURITY=0

# ── Telemetry bounds ─────────────────────────────────────────────────
MAX_EVENTS=2000
MAX_PROVENANCE_PER_SESSION=500
MAX_TRACKED_SESSIONS=1000
